// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette
{
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "agent": {
    "default_profile": "minimal",
    "default_model": {
      "provider": "openrouter",
      "model": "openrouter/free",
      "enable_thinking": true,
    },
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "git_panel": {
    "dock": "left",
  },
  "ssh_connections": [
    {
      "host": "79.174.80.177",
      "username": "root",
      "args": [],
      "projects": [
        {
          "paths": ["/root/renome-cms"],
        },
        {
          "paths": ["/root/server"],
        },
      ],
    },
    {
      "host": "130.49.148.201",
      "username": "root",
      "args": [],
      "projects": [
        {
          "paths": ["/root/sir-rabbit-cms"],
        },
      ],
    },
  ],
  "icon_theme": "Colored Zed Icons Theme Dark",
  "ui_font_size": 16,
  "ui_font_family": "JetBrainsMono Nerd Font",
  "format_on_save": "on",
  "autosave": "on_focus_change",
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_size": 16,
  "buffer_line_height": "standard",
  "buffer_font_features": {
    "calt": true,
    "cv01": 7,
  },
  "close_on_file_delete": true,
  "diagnostics": {
    "include_warnings": true,
    "lsp_pull_diagnostics": {
      "enabled": true,
    },
    "inline": {
      "enabled": true,
    },
  },
  // "bottom_dock_layout": "right_aligned",
  "current_line_highlight": "all",
  "cursor_blink": true,
  "theme": {
    "mode": "system",
    "light": "Gruvbox Light",
    "dark": "Gruvbox Dark",
  },
  "vim_mode": true,
  "vim": {
    "use_system_clipboard": "always",
    "toggle_relative_line_numbers": true,
  },
  "auto_install_extensions": {
    "html": true,
    "dockerfile": true,
    "docker-compose": true,
    "colored-zed-icons-theme": true,
    "sql": true,
    "editorconfig": true,
  },
  "scrollbar": {
    "git_diff": true,
    "search_results": true,
  },
  "tab_bar": { "show_nav_history_buttons": false },
  "tabs": {
    "file_icons": true,
    "git_status": true,
    "show_diagnostics": "all",
    "activate_on_close": "neighbour",
  },
  "terminal": {
    "dock": "bottom",
  },
  "inlay_hints": {
    "enabled": true,
  },
  "lsp": {
    "golangci-lint": {
      "initialization_options": {
        "command": [
          "golangci-lint",
          "run",
          "--fix",
          "--output.json.path=stdout",
          "--show-stats=false",
          "--output.text.path=",
        ],
      },
    },
  },
  "languages": {
    "Go": {
      "language_servers": ["gopls", "golangci-lint"],
    },
    "CSharp": {
      "language_servers": ["omnisharp-roslyn"],
    },
    "Vala": {
      "formatter": {
        "external": {
          "command": "uncrustify",
          "arguments": ["-c=uncrustify.cfg", "-l=vala"],
        },
      },
    },
  },
}
