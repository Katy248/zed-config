// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette
{
  "proxy": "",
  "language_models": {
    "llama.cpp": {
      "context_window": 32000,
      "api_url": "http://localhost:9931",
    },
  },
  "cli_default_open_behavior": "new_window",
  "diff_view_style": "split",
  "project_panel": {
    "dock": "left",
    "auto_fold_dirs": false,
    "diagnostic_badges": true,
  },
  "collaboration_panel": {
    "dock": "right",
  },
  "git_panel": {
    "group_by": "staging",
    "tree_view": true,
    "dock": "right",
    "fallback_branch_name": "main",
    "show_count_badge": true,
  },
  "outline_panel": {
    "dock": "right",
    "button": false,
  },
  "agent": {
    "sandbox_permissions": {
      "network_hosts": [
        "cheatsheetseries.owasp.org",
        "google.github.io",
        "raw.githubusercontent.com",
      ],
    },
    "tool_permissions": {
      "tools": {
        "delete_path": {
          "default": "allow"
        },
        "create_directory": {
          "default": "allow"
        },
        "terminal": {
          "default": "confirm",
          "always_allow": [
            { "pattern": "^go\\s+(build|test|doc|get)" },
            { "pattern": "^gofmt*" },
            { "pattern": "^npm\\s+run\\s+lint" },
            { "pattern": "^npm\\s+run\\s+type-check" },
            {
              "pattern": "^git\\s+--no-pager\\s+diff",
            },
            {
              "pattern": "^git\\s+--no-optional-locks\\s+status",
            },
            {
              "pattern": "*go\\s+test*",
            },
          ],
        },
      },
    },
    "default_profile": "write",
    "default_model": {
      "effort": "low",
      "provider": "openrouter",
      "model": "z-ai/glm-5.3-flashx",
      "enable_thinking": true,
    },
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "ssh_connections": [
    {
      "host": "79.174.80.177",
      "username": "root",
      "args": [],
      "projects": [
        {
          "paths": ["/root/renome-cms"],
        },
        {
          "paths": ["/root/server"],
        },
      ],
    },
    {
      "host": "130.49.148.201",
      "username": "root",
      "args": [],
      "projects": [
        {
          "paths": ["/root/sir-rabbit-cms"],
        },
      ],
    },
    {
      "host": "ship-monitor.ru",
      "username": "root",
      "args": [],
      "projects": [
        {
          "paths": ["/root/frontend"],
        },
      ],
    },
  ],
  "icon_theme": "Colored Zed Icons Theme Dark",
  "ui_font_size": 16,
  "ui_font_family": "JetBrainsMono Nerd Font",
  "format_on_save": "on",
  "autosave": "on_focus_change",
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_size": 16,
  "buffer_line_height": "standard",
  "buffer_font_features": {
    "calt": true,
    "cv01": 7,
  },
  "close_on_file_delete": true,
  "diagnostics": {
    "include_warnings": true,
    "lsp_pull_diagnostics": {
      "enabled": true,
    },
    "inline": {
      "enabled": true,
    },
  },
  // "bottom_dock_layout": "right_aligned",
  "current_line_highlight": "all",
  "cursor_blink": true,
  "theme": {
    "mode": "system",
    "light": "Gruvbox Light",
    "dark": "Gruvbox Dark",
  },
  "vim_mode": true,
  "vim": {
    "use_system_clipboard": "always",
    "toggle_relative_line_numbers": true,
  },
  "auto_install_extensions": {
    "html": true,
    "dockerfile": true,
    "docker-compose": true,
    "colored-zed-icons-theme": true,
    "sql": true,
    "editorconfig": true,
    "golangci-lint": true,
  },
  "scrollbar": {
    "git_diff": true,
    "search_results": true,
  },
  "tab_bar": {
    "show_nav_history_buttons": false,
    "show_pinned_tabs_in_separate_row": true,
    "show": false,
  },
  "tabs": {
    "file_icons": true,
    "git_status": true,
    "show_diagnostics": "all",
    "activate_on_close": "neighbour",
  },
  "terminal": {
    "shell": { "program": "/opt/homebrew/bin/fish" },
    "dock": "bottom",
    "copy_on_select": true,
  },
  "inlay_hints": {
    "enabled": true,
    "show_parameter_hints": false,
    "show_background": true,
  },
  "lsp": {
    "golangci-lint": {
      "initialization_options": {
        "command": [
          "golangci-lint",
          "run",
          "--fix",
          "--output.json.path=stdout",
          "--show-stats=false",
          "--output.text.path=",
        ],
      },
    },
    "ruff": {
      "initialization_options": {
        "settings": {
          // Ruff server settings go here
          "lineLength": 80,
          "lint": {
            "extendSelect": ["I"],
          },
        },
      },
    },
  },
  "languages": {
    "Go": {
      "language_servers": ["gopls", "golangci-lint"],
    },
    "CSharp": {
      "language_servers": ["omnisharp-roslyn"],
    },
    "Vala": {
      "formatter": {
        "external": {
          "command": "uncrustify",
          "arguments": ["-c=uncrustify.cfg", "-l=vala"],
        },
      },
    },
    "Proto": {
      "language_servers": ["protobuf-language-server"],
    },
  },
}
